# Copy to .env and adjust for your machine. Never commit the real .env.
TRANSPORT=at

# --- AT command mode (Huawei E173z-1) -------------------------------------
# Find the port with: python -m scripts.probe_modem --list-ports
# Use the "HUAWEI Mobile Connect - 3G Modem" / PC UI port, not the microSD port.
AT_PORT=COM3
AT_BAUD=115200
AT_COMMAND_TIMEOUT=5
AT_SEND_TIMEOUT=30
AT_RETRIES=1
AT_RETRY_DELAY=3
# Optional override for the SIM's message centre, e.g. AT_SMSC=+447785016005
# AT_SMSC=

# --- HiLink HTTP mode -----------------------------------------------------
HILINK_BASE_URL=http://192.168.8.1
# Leave blank when the web UI does not ask for a password.
# HILINK_USERNAME=admin
# HILINK_PASSWORD=
HILINK_TIMEOUT=15
HILINK_CONTENT_TYPE=text/xml
HILINK_CONTENT_BASE64=false

# --- HTTP API -------------------------------------------------------------
# When set, POST /send-sms requires this value in the X-API-Key header.
# API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEND_LOCK_TIMEOUT=5
MAX_SMS_LENGTH=160
LOG_LEVEL=INFO
