# ==============================================================================
# Dentist Clinic App — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your local environment:
#   cp .env.example .env
#
# DO NOT commit .env with real credentials to source control.
# ==============================================================================

# Database Settings (PostgreSQL Docker container)
POSTGRES_DB=dentist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
# Port exposed on host (5432 default; use 5433 if 5432 is already bound)
POSTGRES_PORT=5432

# Backend API Configuration (.NET 8/10)
# ASPNETCORE_ENVIRONMENT=Development
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=dentist;Username=postgres;Password=your_secure_postgres_password_here

# SMS Gateway Integration (FastAPI + USB GSM Modem)
# Base URL for .NET backend to communicate with SMS service
SMS_GATEWAY_BASE_URL=http://localhost:8000
# Optional API Key for SMS Gateway authentication
SMS_GATEWAY_API_KEY=

# Frontend Configuration (Vite React Dashboard)
# Proxied by Vite dev server (/api -> http://localhost:8080)
VITE_API_BASE_URL=/api
