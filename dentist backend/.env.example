# ==============================================================================
# Dentist Backend (.NET Minimal API) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your environment:
# ==============================================================================

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Connection String
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=dentist;Username=postgres;Password=your_secure_postgres_password_here

# CORS Allowed Origins (comma-separated)
Cors__AllowedOrigins=http://localhost:5173

# SMS Gateway Integration (FastAPI + USB GSM Modem)
SmsGateway__BaseUrl=http://127.0.0.1:8000
SmsGateway__ApiKey=
SmsGateway__TimeoutSeconds=40
SmsGateway__MaxMessageLength=160
